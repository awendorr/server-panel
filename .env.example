# Panel sadece bu adrese bağlanır. 127.0.0.1 dışında bir değer önerilmez.
HOST=127.0.0.1
PORT=7319

# Zorunlu: uzun, rastgele bir değer. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Oturum süresi (saat): bu kadar süre işlem yapılmazsa oturum kapanır
SESSION_TTL_HOURS=12
# Bir girişin en uzun ömrü (saat): kullanılsa bile bu sürenin sonunda yeniden giriş istenir
SESSION_MAX_HOURS=168

# SQLite veritabanı dosyası
DB_PATH=./data/panel.db

# Dosya yöneticisinin erişebileceği kök klasör
FILE_ROOT=/

# Dosya yükleme sınırı (MB)
MAX_UPLOAD_MB=100

# Nginx + HTTPS arkasındaysa 1 yap (secure cookie ve gerçek IP için)
TRUST_PROXY=0

# Canlı metrik aralığı (ms)
METRICS_INTERVAL_MS=2000

# Saklama süreleri
AUDIT_RETENTION_DAYS=90
# Audit kaydında tutulacak en fazla satır (eskiler silinir)
AUDIT_MAX_ROWS=100000

# Giriş denemesi sınırı: LOGIN_WINDOW_MIN dakika içinde LOGIN_MAX_ATTEMPTS hatalı denemeden sonra
# her yeni deneme için giderek artan bir bekleme süresi uygulanır (30 sn, 1 dk, 2 dk ... en fazla pencere kadar).
# Takılırsanız sunucuda: npm run unlock
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MIN=15
