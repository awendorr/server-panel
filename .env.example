# Panel sadece bu adrese bağlanır. 127.0.0.1 dışında bir değer önerilmez.
HOST=127.0.0.1
PORT=7319

# Zorunlu: uzun, rastgele bir değer. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Oturum süresi (saat)
SESSION_TTL_HOURS=12

# SQLite veritabanı dosyası
DB_PATH=./data/panel.db

# Dosya yöneticisinin erişebileceği kök klasör
FILE_ROOT=/

# Dosya yükleme sınırı (MB)
MAX_UPLOAD_MB=100

# Nginx + HTTPS arkasındaysa 1 yap (secure cookie ve gerçek IP için)
TRUST_PROXY=0

# Canlı metrik aralığı (ms)
METRICS_INTERVAL_MS=2000

# Saklama süreleri
AUDIT_RETENTION_DAYS=90

# Giriş denemesi sınırı: LOGIN_WINDOW_MIN dakikada LOGIN_MAX_ATTEMPTS hatalı deneme
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MIN=15
