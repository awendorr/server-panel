{
  "name": "server-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Linux sunucu yönetim ve izleme paneli",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node --watch server/index.js",
    "build:css": "tailwindcss -i ./public/css/tailwind.src.css -o ./public/css/tailwind.css --minify",
    "create-user": "node server/scripts/create-user.js",
    "rename-user": "node server/scripts/rename-user.js",
    "unlock": "node server/scripts/unlock.js"
  },
  "allowScripts": {
    "bcrypt": true,
    "better-sqlite3": true,
    "node-pty": true
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "monaco-editor": "^0.57.0",
    "multer": "^2.4.0",
    "node-pty": "^1.1.0",
    "pm2": "^7.0.4",
    "socket.io": "^4.8.4",
    "systeminformation": "^5.33.15"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
